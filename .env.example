# Copy to .env.local and fill in from Supabase → Project Settings → API (and add the same on Vercel).
# Without these the site still works: it shows the sample content from content/en.json and /admin is locked.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Used to save contact messages / sign-ups and by the cron.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Vercel sends it to /api/keepalive (set it in Vercel env vars).
CRON_SECRET=
# Optional, Vercel PREVIEW env only: 1 = /admin opens without login with sample data (read-only).
# Ignored on Production and ignored once the Supabase keys above are set.
ADMIN_DEMO=
# Public address once the domain is connected, e.g. https://oneforthegirls.com (used for sitemap + share images).
NEXT_PUBLIC_SITE_URL=
# Optional: email alert for each new Say Hello message (resend.com, free plan). Comma-separate several emails.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Optional: sender once your domain is verified in Resend, e.g. One For The Girls <hello@oneforthegirls.com>
NOTIFY_FROM=
